# Optional: increases the OpenAlex daily budget. Keep the actual key in .env.
OPENALEX_API_KEY=
# Optional: enables independent website search; without it use ChatGPT web search.
BRAVE_SEARCH_API_KEY=
# Local testing defaults. Only change HOST for a reviewed deployment.
HOST=127.0.0.1
PORT=8787
# Comma-separated hostnames accepted by HTTP transport, including port if used.
ALLOWED_HOSTS=localhost:8787,127.0.0.1:8787
